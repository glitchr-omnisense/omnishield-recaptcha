# PHPStan at the highest level, as glitchr-studio/ci's workflow runs it. phpstan-baseline.neon is
# empty (the workflow requires the file): nothing is accepted, anything PHPStan reports fails.
includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - .
    excludePaths:
        - vendor (?)
        - docker (?)
        - Tests/Fixtures (?)
